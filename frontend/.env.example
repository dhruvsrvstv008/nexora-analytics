# ── Frontend environment variables ────────────────────────────────────────────
# Copy to frontend/.env.local for local development (Vite ignores .env by default).
# On Netlify, paste into Site configuration → Environment variables.
#
# All VITE_ variables are embedded in the JS bundle at build time.
# Never put secrets here — they are visible to anyone who downloads the bundle.

# Base URL of the Render backend (no trailing slash, no /api/v1 suffix).
# Leave unset locally — the Vite dev server proxies /api/* to localhost:8000.
# Production example:
VITE_API_URL=https://YOUR_APP.onrender.com
