# ── Backend environment variables ─────────────────────────────────────────────
# Copy to backend/.env for local development.
# On Render, paste each key into Environment → Environment Variables.
#
# DATABASE_URL and SECRET_KEY have NO defaults — the app refuses to start
# without them (Pydantic raises ValidationError at import time).
# Never commit a real .env file; it is in .gitignore.

# PostgreSQL connection string.
# Local: use the credentials from docker-compose.yml
# Production: use the Supabase connection string (Session Mode, port 5432)
DATABASE_URL=postgresql+psycopg2://nexora:CHANGE_ME@localhost:5432/nexora_db

# JWT signing secret. Must be long and random.
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=production

# Comma-separated list of allowed CORS origins (no trailing slash).
# Production: set to your Netlify site URL.
CORS_ORIGINS=https://YOUR_SITE.netlify.app
